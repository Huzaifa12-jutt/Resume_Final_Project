# TalentLens Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_RESUME_BUCKET=resumes

# Groq API (for AI HR assistant chatbot)
GROQ_API_KEY=gsk_your_groq_api_key

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT
JWT_SECRET=your-random-jwt-secret-min-32-chars
JWT_EXPIRES_MINUTES=60

# App
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
MAX_UPLOAD_MB=10

# SMTP (for email verification & password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com
# Set to "true" to disable email delivery in development
EMAIL_DELIVERY_DISABLED=false

# Gmail integration (fetch resumes from the recruiter inbox)
# Create a Google Cloud OAuth client (Web application) and enable the Gmail API.
# Add this exact redirect URI to the client Authorized redirect URIs:
#   http://localhost:8000/gmail/auth/callback
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
# Optional -- defaults to http://localhost:8000/gmail/auth/callback
GMAIL_REDIRECT_URI=http://localhost:8000/gmail/auth/callback
# Optional -- max messages to scan per folder (INBOX + SPAM)
GMAIL_FETCH_LIMIT=50
